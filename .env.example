# QuotaFuse Wire 环境变量示例。复制为 .env.local 后按需修改，程序会自动读取。
# 真实环境变量优先于 .env / .env.local；所有变量都有默认值。
# 带密钥的文件不要提交到仓库。

# 数据目录与配置目录
QF_WIRE_DATA_DIR=./data
QF_WIRE_CONFIG_DIR=./config
QF_WIRE_PROMPTS_DIR=./prompts

# 日志级别：DEBUG / INFO / WARNING / ERROR
QF_WIRE_LOG_LEVEL=INFO
# 可选：日志同时写入文件（自动按 5MB 轮转，保留 3 份）
QF_WIRE_LOG_FILE=

# 本地看板与只读 API，默认仅本机监听
QF_WIRE_HOST=127.0.0.1
QF_WIRE_PORT=8790
# 只读 API 鉴权：token 为空时仅回环地址可读；填了 token 后远程请求需带
# Authorization: Bearer <token>。本机浏览器默认仍免 token。
QF_WIRE_API_TOKEN=
# 设为 true 后本机也必须带 token（放反向代理后面时常用）
QF_WIRE_API_REQUIRE_TOKEN=false
# 允许跨域读取的站点，逗号分隔，例如 https://example.com
QF_WIRE_CORS_ORIGINS=
# 允许同网段（私有地址）免 token 访问；默认 false
QF_WIRE_ALLOW_PRIVATE_NETWORK=false

# MCP HTTP 监听端口，默认仅本机
QF_WIRE_MCP_HOST=127.0.0.1
QF_WIRE_MCP_PORT=8791

# 采集：全局并发上限（1..64，默认 24）；单源超时与重试在 sources.yaml 配置
QF_WIRE_FETCH_CONCURRENCY=24

# 海外源代理（可选）
HTTP_PROXY=
HTTPS_PROXY=

# 模型：provider 可选 claude-cli（本机订阅）或 api（任意 OpenAI 兼容接口）
# provider / 模型名在这里覆盖 config/digest.yaml；url 和 key 只在 provider=api 时使用
QF_WIRE_DIGEST_PROVIDER=claude-cli
QF_WIRE_DIGEST_MODEL=
QF_WIRE_API_BASE=
QF_WIRE_API_KEY=
# 也认 OpenAI 官方变量名
OPENAI_BASE_URL=
OPENAI_API_KEY=
# 本机 claude CLI 路径（可选）
QF_WIRE_CLAUDE_BIN=

# 多用户隔离（M4）：开启后每个用户使用 <data>/users/<id>/ 下的独立 SQLite 与归档
QF_WIRE_MULTIUSER=false
# 当前用户 id（也可用全局参数 --user），只在多用户模式下生效
QF_WIRE_USER=

# 定时调度（M4）：任务写在 config/schedule.yaml，用 qfw schedule 或
# qfw serve --with-scheduler 启动；Docker Compose 默认已随看板启动。
