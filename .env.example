# QuotaFuse Wire 环境变量示例。复制为 .env.local 后按需修改，程序会自动读取。
# 真实环境变量优先于 .env / .env.local；所有变量都有默认值。
# 带密钥的文件不要提交到仓库。

# 数据目录与配置目录
QF_WIRE_DATA_DIR=./data
QF_WIRE_CONFIG_DIR=./config
QF_WIRE_PROMPTS_DIR=./prompts

# 日志级别：DEBUG / INFO / WARNING / ERROR
QF_WIRE_LOG_LEVEL=INFO

# 本地看板与只读 API，默认仅本机监听
QF_WIRE_HOST=127.0.0.1
QF_WIRE_PORT=8790
# 只读 API 鉴权开关：为空表示仅本机访问、不要求 token
QF_WIRE_API_TOKEN=

# MCP HTTP 监听端口，默认仅本机
QF_WIRE_MCP_HOST=127.0.0.1
QF_WIRE_MCP_PORT=8791

# 采集：全局并发上限（1..64，默认 24）；单源超时与重试在 sources.yaml 配置
QF_WIRE_FETCH_CONCURRENCY=24

# 海外源代理（可选）
HTTP_PROXY=
HTTPS_PROXY=

# 模型：provider 可选 claude-cli（本机订阅）或 api（任意 OpenAI 兼容接口）
# provider / 模型名在这里覆盖 config/digest.yaml；url 和 key 只在 provider=api 时使用
QF_WIRE_DIGEST_PROVIDER=claude-cli
QF_WIRE_DIGEST_MODEL=
QF_WIRE_API_BASE=
QF_WIRE_API_KEY=
# 也认 OpenAI 官方变量名
OPENAI_BASE_URL=
OPENAI_API_KEY=
# 本机 claude CLI 路径（可选）
QF_WIRE_CLAUDE_BIN=

# 多用户隔离（M4）：开启后按用户目录隔离配置与 SQLite
QF_WIRE_MULTIUSER=false
