# QuotaFuse Wire 环境变量示例。复制为 .env 后按需修改。
# 所有配置都有默认值；未设置时使用本机本地模式。

# 数据目录与数据库
QF_WIRE_DATA_DIR=./data
QF_WIRE_CONFIG_DIR=./config
QF_WIRE_DB=./data/wire.db

# 日志级别：DEBUG / INFO / WARNING / ERROR
QF_WIRE_LOG_LEVEL=INFO

# 本地看板与只读 API，默认仅本机监听
QF_WIRE_HOST=127.0.0.1
QF_WIRE_PORT=8790
# 只读 API 鉴权开关：为空表示仅本机访问、不要求 token
QF_WIRE_API_TOKEN=

# MCP HTTP 监听端口，默认仅本机
QF_WIRE_MCP_HOST=127.0.0.1
QF_WIRE_MCP_PORT=8791

# 采集：全局并发上限（1..64，默认 24）；单源超时与重试在 sources.yaml 配置
QF_WIRE_FETCH_CONCURRENCY=24

# 海外源代理（可选）
HTTP_PROXY=
HTTPS_PROXY=

# 模型：两种 provider，任选其一
# claude-cli → 使用本机 Claude 订阅（零成本）
# api        → 任意 OpenAI 兼容 API
LLM_PROVIDER=claude-cli
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 多用户隔离（M4）：开启后按用户目录隔离配置与 SQLite
QF_WIRE_MULTIUSER=false
