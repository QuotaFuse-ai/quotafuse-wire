# 本地配置模板：qfw 启动时会自动读取仓库根目录的这个文件。
# 真实环境变量优先于本文件；等号后留空表示使用默认值。
# 注意：这个文件会进 git，保持为空。填了密钥后不要 git add / commit 本文件。
# 有密钥的本地覆盖请写到 .env.local（已被 .gitignore 忽略）。

# ---- 目录 ----
QF_WIRE_DATA_DIR=
QF_WIRE_CONFIG_DIR=
QF_WIRE_PROMPTS_DIR=

# ---- 日志 ----
QF_WIRE_LOG_LEVEL=

# ---- 本地看板与只读 API ----
QF_WIRE_HOST=
QF_WIRE_PORT=
QF_WIRE_API_TOKEN=

# ---- MCP ----
QF_WIRE_MCP_HOST=
QF_WIRE_MCP_PORT=

# ---- 采集 ----
QF_WIRE_FETCH_CONCURRENCY=

# ---- 海外源代理（可选）----
HTTP_PROXY=
HTTPS_PROXY=

# ---- 模型 ----
# provider / 模型名也可以写在这里，覆盖 config/digest.yaml 的同名项。
# provider 可选 claude-cli / api；url 和 key 只在 provider=api 时使用。
QF_WIRE_DIGEST_PROVIDER=
QF_WIRE_DIGEST_MODEL=
QF_WIRE_API_BASE=
QF_WIRE_API_KEY=
# 兼容 OpenAI 官方变量名（按需填写）
OPENAI_BASE_URL=
OPENAI_API_KEY=
# 本机 claude CLI 路径（可选，默认从 PATH 查找）
QF_WIRE_CLAUDE_BIN=

# ---- 多用户隔离（M4）----
QF_WIRE_MULTIUSER=
