{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quotafuse.ai/schema/sources.schema.json",
  "title": "QuotaFuse Wire sources config",
  "type": "object",
  "required": ["version", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_sec": { "type": "integer", "minimum": 1, "maximum": 120 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "weight": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["rss", "html", "api"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "timeout_sec": { "type": "integer", "minimum": 1, "maximum": 120 },
          "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
          "weight": { "type": "number", "minimum": 0, "maximum": 10 },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
